# ============================================
# Fargonam Production Environment Variables
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring
# ============================================

# Database
DB_USER=fargonam
DB_PASSWORD=KUCHLI_PAROL_KIRITING
DB_NAME=fargonam_db

# Redis
REDIS_PASSWORD=KUCHLI_REDIS_PAROL

# JWT Secret (kamida 32 belgi)
SECRET_KEY=KAMIDA_32_BELGILI_RANDOM_KALIT_KIRITING

# CORS (vergul bilan ajratilgan)
ALLOWED_ORIGINS=https://fargonam.uz,https://admin.fargonam.uz

# Firebase Push Notification (Firebase Console > Project Settings > Cloud Messaging)
FCM_SERVER_KEY=

# S3/MinIO
S3_ACCESS_KEY=fargonam_minio
S3_SECRET_KEY=KUCHLI_MINIO_PAROL
S3_PUBLIC_URL=https://cdn.fargonam.uz

# Portlar
HTTP_PORT=80
HTTPS_PORT=443

# Sotuvchi web paneli (/dokon) — oddiy umumiy login/parol
SELLER_LOGIN=sotuvchiuz
# Ochiq parol emas — bcrypt hash. Generatsiya:
#   cd backend && .venv/bin/python -m scripts.hash_seller_password <parol>
# MUHIM: bcrypt hash tarkibidagi har bir "$" belgisini "$$" qilib yoz —
# docker-compose .env faylini o'qiyotganda "$so'z" ko'rinishidagi
# qismlarni o'zgaruvchi deb hisoblab, aniqlanmasa jimgina bo'sh qatorga
# almashtiradi (masalan "$jE0l5lt" yo'qolib, hash butunlay buziladi va
# login har doim 500 xato bilan tushib ketadi). backend/.env (lokal, docker
# emas) da bu shart emas — faqat root .env (docker-compose) uchun kerak.
SELLER_PASSWORD_HASH=
