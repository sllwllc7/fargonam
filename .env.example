# ============================================
# Fargonam Production Environment Variables
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring
# ============================================

# Database
DB_USER=fargonam
DB_PASSWORD=KUCHLI_PAROL_KIRITING
DB_NAME=fargonam_db

# Redis
REDIS_PASSWORD=KUCHLI_REDIS_PAROL

# JWT Secret (kamida 32 belgi)
SECRET_KEY=KAMIDA_32_BELGILI_RANDOM_KALIT_KIRITING

# CORS (vergul bilan ajratilgan)
ALLOWED_ORIGINS=https://fargonam.uz,https://admin.fargonam.uz

# Firebase Push Notification (Firebase Console > Project Settings > Cloud Messaging)
FCM_SERVER_KEY=

# S3/MinIO
S3_ACCESS_KEY=fargonam_minio
S3_SECRET_KEY=KUCHLI_MINIO_PAROL
S3_PUBLIC_URL=https://cdn.fargonam.uz

# Portlar
HTTP_PORT=80
HTTPS_PORT=443
